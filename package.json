{
  "name": "fcl-finance-app",
  "version": "1.13.11",
  "description": "A Quasar Project",
  "productName": "FCL Finance App",
  "author": "ziegfrid.gualberto@gmail.com",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "dev": "quasar dev",
    "dev:android": "quasar dev -m capacitor -T android",
    "dev:electron": "quasar dev -m electron",
    "build:android": "quasar build -m capacitor -T android && xdg-open src-capacitor/android/app/build/outputs/apk/release",
    "build:android:gradle-release": "cd src-capacitor/android && ./gradlew assembleRelease",
    "cap": "cd src-capacitor && npx cap",
    "cap:sync:android": "cd src-capacitor && npx cap sync android",
    "cap:open:android": "cd src-capacitor && npx cap open android",
    "build": "quasar build",
    "build:electron": "quasar build -m electron",
    "build:electron:linux": "quasar build -m electron -T linux",
    "build:electron:mac": "quasar build -m electron -T mac",
    "postinstall": "quasar prepare && mkdir -p public/assets && cp node_modules/sql.js/dist/sql-wasm.wasm public/assets/sql-wasm.wasm"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@quasar/extras": "^1.16.4",
    "axios": "^1.2.1",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jeep-sqlite": "^2.8.0",
    "jspdf": "^4.1.0",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "sql.js": "1.12.0",
    "vue": "^3.5.22",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.2",
    "@electron/packager": "^18.3.2",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.64.0",
    "@quasar/app-vite": "^2.1.0",
    "@types/node": "^20.5.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "apexcharts": "^5.6.0",
    "autoprefixer": "^10.4.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.2",
    "vite-plugin-checker": "^0.11.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7",
    "vue3-apexcharts": "^1.10.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
